# DGSRSim GaussianModel workflow

# 1. Convert one captured multi-view scene.
python convert.py -s data/<scene_name>

# 2. Place cross-view instance masks in data/<scene_name>/object_mask.
# The masks may come from dataset annotations or another annotation tool.
# DEVA is optional and is used only to prepare masks:
bash script/prepare_pseudo_label0.sh <scene_name> <image_scale>

# 3. Train the shared Gaussian field and classifier with the released config.
bash script/train.sh <scene_name> <image_scale>

# 4. Render the configured evaluation split.
python render.py -m output/<scene_name> --config_file config/gaussian_dataset/train0.json

# 5. Evaluate explicit object and background regions.
python metrics1.py -r <renders> -g <references> --mask_dir <binary_or_label_masks> --region object
python metrics1.py -r <renders> -g <references> --mask_dir <binary_or_label_masks> --region background

# 6. Filter an exported Gaussian PLY before USD/USDZ conversion.
python ../third_party/3dgrut_conversion/crop_gaussian_ply.py <input.ply> --output <filtered.ply>

# Canonical public entry points are listed in docs/CANONICAL_ENTRYPOINTS.md.
# Numbered historical variants are retained for provenance, not as defaults.
